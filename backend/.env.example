# Database Configuration
DATABASE_URL=postgresql+asyncpg://codearena:codearena_pass@postgres:5432/codearena

# Redis Configuration (Cache, Matchmaking Queue, Socket Pub/Sub)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Security & JWT
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Google Gemini AI for Post-Match Code Reviews
GEMINI_API_KEY=your-gemini-api-key

# URLs
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
