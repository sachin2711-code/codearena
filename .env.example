# CodeArena Environment Variables

# Security
SECRET_KEY=generate-a-secure-random-32-char-string-for-prod

# Google OAuth (Optional for local dev, required for prod Google Sign-in)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google Gemini API (For post-match AI code analysis)
GEMINI_API_KEY=your-gemini-api-key

# Database & Cache (Docker defaults already configured in docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://codearena:codearena_pass@postgres:5432/codearena
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
